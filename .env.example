# Server configuration
PORT=3000
NODE_ENV=development
APP_URL="http://localhost:3000"
CORS_ORIGIN="http://localhost:3000"

# MySQL database connection (never commit real credentials)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=watchtower_user
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DB_NAME=watchtower_db
TEST_DB_NAME=watchtower_test

# Authentication (JWT)
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CHANGE_ME_MINIMUM_32_CHARS_RANDOM_SECRET
JWT_EXPIRES_IN=15m
JWT_REFRESH_DAYS=7
COOKIE_SECURE=false
BCRYPT_ROUNDS=12

# Development seed passwords (never use these in production).
# One distinct password per demo actor; SEED_DEMO_PASSWORD is kept as a
# fallback for older setups but the three actor-specific values take priority.
SEED_DEMO_PASSWORD=CHANGE_ME_DEMO_PASSWORD
SEED_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
SEED_MANAGER_PASSWORD=CHANGE_ME_MANAGER_PASSWORD
SEED_MEMBER_PASSWORD=CHANGE_ME_MEMBER_PASSWORD

# Development-only password reset helper. Set to false to hide the token from API responses.
EXPOSE_RESET_TOKEN=true
RESET_TOKEN_MINUTES=30

# Network / rate limiting
# Leave empty when the API is directly exposed. Set to 1 only when exactly one
# trusted reverse proxy sits in front of the API (otherwise clients can spoof X-Forwarded-For).
TRUST_PROXY=
# Tests disable limiters by default; set true in a test environment to assert 429 responses.
RATE_LIMIT_ENABLED=false
