# Server configuration
PORT=3000
NODE_ENV=development
APP_URL="http://localhost:3000"
CORS_ORIGIN="http://localhost:3000"

# MySQL database connection (never commit real credentials in .env)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=watchtower_user
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DB_NAME=watchtower_db
TEST_DB_NAME=watchtower_test

# Authentication (JWT) - use a long random secret in production
JWT_SECRET=CHANGE_ME_MINIMUM_32_CHARS_RANDOM_SECRET
JWT_EXPIRES_IN=15m
COOKIE_SECURE=false

# GEMINI_API_KEY: Required only if Gemini AI features are later enabled
GEMINI_API_KEY="MY_GEMINI_API_KEY"
