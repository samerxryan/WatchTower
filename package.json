    "express": "^5.1.0",
    "express-rate-limit": "^8.7.5",
    "globals": "^17.14.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.76.0",
    "motion": "^12.23.24",
